# ==============================================================================
# WanderPlan FastAPI Backend Environment Variables
# ==============================================================================

# Server settings
PORT=8000
ENVIRONMENT=production
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://*.vercel.app

# Groq AI settings (Get key from https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Unsplash API settings (Get key from https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
UNSPLASH_APP_NAME=WanderPlan

# Supabase settings (Get credentials from https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
